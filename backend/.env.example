# For PostgreSQL (Docker / Production)
# DATABASE_URL=postgresql://trustvault:trustvault_secret@localhost:5432/trustvault

# For SQLite (Local zero-dependency development and testing)
DATABASE_URL="file:./dev.db"

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=super_secure_vault_session_secret_key_1234567890_min_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./vault_storage
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
