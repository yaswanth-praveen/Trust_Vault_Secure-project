# Database Configuration (PostgreSQL)
POSTGRES_USER=trustvault
POSTGRES_PASSWORD=trustvault_secret
POSTGRES_DB=trustvault
DATABASE_URL=postgresql://trustvault:trustvault_secret@localhost:5432/trustvault

# Application Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Security & Session
SESSION_SECRET=c8f8b3b64c23f4b4a68c09a32c74e1d15bf3c39d8b746a5c9f28a7e0b1234567
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./vault_storage

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
